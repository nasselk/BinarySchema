{
	"type": "module",
	"name": "@nasselk/binaryschema",
	"author": "nasselk",
	"description": "Typescript blazing fast data encoding library",
	"version": "0.1.0",
	"license": "MIT",
	"homepage": "https://github.com/nasselk/BinarySchema",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nasselk/BinarySchema.git"
	},
	"bugs": {
		"url": "https://github.com/nasselk/BinarySchema/issues",
		"email": "nassim.elkarati@gmail.com"
	},
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"test": "bun test",
		"types:check": "tsc --noEmit && tsc -p tsconfig.test.json",
		"biome:check": "biome check --write",
		"bench": "bun bench/bench.ts",
		"bench:node": "bun build bench/bench.ts --target=node --outfile bench/.out/bench.mjs && node bench/.out/bench.mjs"
	},
	"dependencies": {
		"@nasselk/binarypack": "github:nasselk/BinaryPack"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@colyseus/schema": "^5.0.42",
		"@msgpack/msgpack": "^3.1.3",
		"@types/bun": "^1.4.4",
		"avsc": "^5.7.9",
		"flatbuffers": "^25.9.23",
		"protobufjs": "^8.8.1",
		"typescript": "^7.0.2"
	}
}
