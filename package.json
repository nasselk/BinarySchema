{
	"type": "module",
	"name": "@nasselk/binaryschema",
	"author": "nasselk",
	"description": "TypeScript schemas compiled ahead of time into fast, fully typed binary encoders and decoders",
	"version": "0.1.0",
	"license": "MIT",
	"homepage": "https://github.com/nasselk/BinarySchema",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nasselk/BinarySchema.git"
	},
	"bugs": {
		"url": "https://github.com/nasselk/BinarySchema/issues",
		"email": "nassim.elkarati@gmail.com"
	},
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"bin": {
		"binaryschema": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"test": "bun test",
		"typecheck": "tsc --noEmit -p . && bun tests/setup.ts && tsc -p tests/tsconfig.json",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"biome:check": "biome check --write",
		"bench": "bun src/cli.ts bench/schemas.ts --runtime ../src/runtime.js && bun bench/bench.ts",
		"bench:node": "bun src/cli.ts bench/schemas.ts --runtime ../src/runtime.js && bun build bench/bench.ts --target=node --outfile bench/.out/bench.mjs && node bench/.out/bench.mjs"
	},
	"dependencies": {
		"@nasselk/binarypack": "github:nasselk/BinaryPack"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@colyseus/schema": "^5.0.42",
		"@msgpack/msgpack": "^3.1.3",
		"@types/bun": "^1.4.4",
		"avsc": "^5.7.9",
		"flatbuffers": "^25.9.23",
		"protobufjs": "^8.8.1",
		"typescript": "^7.0.2"
	}
}
